# SOLace environment variables — copy to .env.local for local development
# Never commit .env or .env.local to git

# ── Existing (required) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Better Auth (required) ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_32_plus_char_random_string

# Base URL of the deployment (no trailing slash)
# Development: http://localhost:3000
# Production:  https://learnsolace.org
BETTER_AUTH_URL=https://learnsolace.org

# ── CORS (required) ──────────────────────────────────────────────────────────
# Must match BETTER_AUTH_URL
ALLOWED_ORIGIN=https://learnsolace.org

# ── SendGrid email (required for teacher email verification) ─────────────────
SENDGRID_API_KEY=SG.replace_with_your_sendgrid_api_key
FROM_EMAIL=noreply@learnsolace.org

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# If set, a "Continue with Google" button appears on the teacher login page.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: https://learnsolace.org/api/auth/callback/google
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
